# ==========================================================
# Backend Service Environment Variables (.env)
# ==========================================================

PORT=5000
NODE_ENV=production

# MongoDB connection string (Required for production Vercel deployment)
# Example MongoDB Atlas URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/energy_dashboard?retryWrites=true&w=majority

# JWT Signing Secret (Required)
JWT_SECRET=your_super_secret_jwt_key_here

# Microservice URL for FastAPI ML Service
# In local development: http://localhost:8000
# On Vercel: Set to your deployment's ML path or external service URL
ML_SERVICE_URL=http://localhost:8000

# Client origin for CORS (Optional, defaults to localhost and *.vercel.app)
CLIENT_URL=http://localhost:5173
