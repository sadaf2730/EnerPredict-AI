{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    },
    "api/ml.py": {
      "includeFiles": [
        "ml-service/app.py",
        "ml-service/predict.py",
        "ml-service/model.pkl",
        "ml-service/preprocessor.pkl",
        "ml-service/metrics.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/ml/:path*",
      "destination": "/api/ml"
    },
    {
      "source": "/ml/:path*",
      "destination": "/api/ml"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}