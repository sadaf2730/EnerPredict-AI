{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    },
    "api/ml.py": {
      "includeFiles": "ml-service/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/ml/:path*",
      "destination": "/api/ml"
    },
    {
      "source": "/ml/:path*",
      "destination": "/api/ml"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}