# ==========================================================
# EnerPredict AI - Root Vercel Environment Variables
# ==========================================================

# Database
# Required: Hosted MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/energy_dashboard?retryWrites=true&w=majority

# Authentication
# Required: Secret key used to sign JWT tokens for user sessions
JWT_SECRET=your_super_secret_production_jwt_key_here

# Microservice Routing
# Optional in single-domain Vercel deployment: can point to internal serverless path (/api/ml) or external FastAPI host
# Defaults to http://localhost:8000 in local development
ML_SERVICE_URL=http://localhost:8000

# Frontend API URL
# Leave empty on Vercel to automatically use same-origin /api rewrites
# Set to http://localhost:5000/api for local independent frontend dev
VITE_API_URL=

# CORS & Domain
NODE_ENV=production
CLIENT_URL=https://enerpredict-ai.vercel.app
